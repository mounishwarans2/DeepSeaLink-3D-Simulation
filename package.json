{
  "name": "deepsealink-simulation",
  "productName": "DeepSeaLink 3D Simulation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "DeepSeaLink Deep Ocean Underwater Acoustic Communication Digital Twin",
  "author": "DeepSeaLink",
  "homepage": "https://github.com/deepsealink/simulation",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:start": "electron electron/main.cjs",
    "electron:dev": "concurrently -k -n \"VITE,ELECTRON\" -c \"cyan,green\" \"vite\" \"wait-on http://localhost:5173 && NODE_ENV=development electron electron/main.cjs\"",
    "electron:preview": "NODE_ENV=production electron electron/main.cjs",
    "electron:build": "npm run build && electron-builder --linux",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:all": "npm run build && electron-builder --linux --win"
  },
  "build": {
    "appId": "com.deepsealink.simulation",
    "productName": "DeepSeaLink 3D Simulation",
    "copyright": "Copyright © 2024 DeepSeaLink",
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "package.json",
      "!src",
      "!public",
      "!electron/resources",
      "!.git",
      "!node_modules"
    ],
    "directories": {
      "output": "release",
      "buildResources": "electron/resources"
    },
    "artifactName": "DeepSeaLink-3D-Simulation.${ext}",
    "asar": true,
    "compression": "maximum",
    "icon": "electron/resources/icon.png",
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb",      "arch": ["x64"] }
      ],
      "category": "Science",
      "description": "DeepSeaLink Deep Ocean Underwater Acoustic Communication Digital Twin",
      "icon": "electron/resources/icon.png",
      "maintainer": "DeepSeaLink"
    },
    "deb": {
      "packageCategory": "science",
      "priority": "optional",
      "depends": ["libgtk-3-0", "libnotify4", "libnss3", "libxss1", "libxtst6", "xdg-utils", "libatspi2.0-0", "libuuid1", "libsecret-1-0"]
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "electron/resources/icon.png",
      "artifactName": "DeepSeaLink-3D-Simulation-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeepSeaLink 3D Simulation"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.productivity",
      "artifactName": "DeepSeaLink-3D-Simulation.${ext}"
    }
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@types/three": "^0.185.4",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.5",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  }
}
